import os
import time
import glob
from datetime import datetime
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import streamlit as st

DADOS_DIR = "dados"
COLS = ["time_ms", "erro", "kp", "ki", "kd", "integral", "derivativo",
        "s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7",
        "posicao", "velEsq", "velDir", "velBase"]

os.makedirs(DADOS_DIR, exist_ok=True)
st.set_page_config(page_title="Painel LARI", layout="wide")
st.title("Painel análise PID")

aba_sd, aba_usb, aba_analisar = st.tabs([
    "Importar do Cartão SD",
    "Gravar via USB",
    "Analisar",
])
# FUNÇÕES COMPARTILHADAS
def carregar_e_limpar(caminho):
    df = pd.read_csv(caminho, header=None, names=COLS, skiprows=1, engine="python", on_bad_lines="skip")
    for col in df.columns:
        df[col] = pd.to_numeric(df[col], errors="coerce")
    df = df.dropna().reset_index(drop=True)
    df["time_s"] = (df["time_ms"] - df["time_ms"].iloc[0]) / 1000.0
    return df


def calcular_metricas(df):
    erro = df["erro"].to_numpy()
    mae = np.abs(erro).mean()
    rmse = np.sqrt((erro ** 2).mean())
    overshoot = np.abs(erro).max()
    sinais = np.sign(erro)
    sinais = sinais[sinais != 0]
    oscilacoes = int(np.sum(np.diff(sinais) != 0)) if len(sinais) > 1 else 0
    pwm_diff = np.abs(df["velEsq"] - df["velDir"]).mean()
    gaps = df["time_ms"].diff()
    perdas = gaps[gaps > 15]
    return {
        "MAE": round(mae, 1),
        "RMSE": round(rmse, 1),
        "Overshoot": round(overshoot, 1),
        "Oscilações": oscilacoes,
        "Esforço PWM": round(pwm_diff, 1),
        "Perdas de linha": len(perdas),
    }

def listar_csvs():
    return sorted(glob.glob(os.path.join(DADOS_DIR, "*.csv")))


def mostrar_analise_rapida(df):
    m = calcular_metricas(df)
    cols = st.columns(len(m))
    for (nome, valor), c in zip(m.items(), cols):
        c.metric(nome, valor)

    fig, axes = plt.subplots(2, 1, figsize=(10, 6), sharex=True)
    axes[0].plot(df["time_s"], df["erro"], color="crimson", linewidth=1)
    axes[0].axhline(0, color="gray", linestyle="--", linewidth=0.8)
    axes[0].set_ylabel("Erro")
    axes[0].grid(alpha=0.3)
    axes[1].plot(df["time_s"], df["velEsq"], label="PWM esquerdo", linewidth=1)
    axes[1].plot(df["time_s"], df["velDir"], label="PWM direito", linewidth=1)
    axes[1].set_ylabel("PWM")
    axes[1].set_xlabel("Tempo (s)")
    axes[1].legend()
    axes[1].grid(alpha=0.3)
    fig.tight_layout()
    st.pyplot(fig)
# ABA 1 — IMPORTAR DO CARTÃO SD (fluxo principal

with aba_sd:
    st.write(
        "Depois da corrida, tire o cartão SD do robô e coloque no leitor do seu "
        "computador (ou conecte o robô por USB só para copiar o arquivo, sem "
        "precisar dele ligado durante a prova). O cartão vai aparecer como mais "
        "um HD/pendrive no Windows (ex: `E:\\`), com arquivos `corrida_001.csv`, "
        "`corrida_002.csv`, etc."
    )
    st.write("Clique abaixo e navegue até o cartão SD para escolher o(s) arquivo(s):")

    arquivos_upload = st.file_uploader(
        "Selecionar arquivo(s) CSV do cartão SD",
        type=["csv"],
        accept_multiple_files=True,
    )

    if arquivos_upload:
        for arq in arquivos_upload:
            destino = os.path.join(DADOS_DIR, arq.name)
            with open(destino, "wb") as f:
                f.write(arq.getbuffer())
            st.success(f"Importado: {arq.name}")
            
        if len(arquivos_upload) == 1:
            st.subheader("Prévia da corrida importada")
            try:
                df = carregar_e_limpar(os.path.join(DADOS_DIR, arquivos_upload[0].name))
                mostrar_analise_rapida(df)
            except Exception as e:
                st.warning(f"Arquivo importado, mas não consegui montar a análise automática: {e}")
        else:
            st.info("Arquivos importados. Vá na aba 'Analisar / Comparar' para ver todos juntos.")



# ABA 2 — GRAVAR VIA USB (só bancada, não serve para a prova oficial)
# ABA ANTIGA, JA ELIMINADA DO PROJETO
with aba_usb:
    st.warning(
        "Isso só funciona com o robô preso na mesa/perto do computador, "
        "ligado por cabo USB. **Não use isso durante a prova de verdade** "
