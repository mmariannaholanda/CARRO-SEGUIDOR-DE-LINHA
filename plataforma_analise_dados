        label = st.text_input("Rótulo da corrida (opcional)", value="", placeholder="ex: bancada1")
    with col3:
        kp_in = st.text_input("Kp usado (opcional)", value="")
        kd_in = st.text_input("Kd usado (opcional)", value="")

    iniciar = st.button("Gravar (bancada)", type="primary")


# ABA 3 — ANALISAR / COMPARAR

with aba_analisar:
    arquivos = listar_csvs()
    if not arquivos:
        st.info("Nenhuma corrida disponível ainda. Importe do cartão SD, grave uma corrida de bancada, ou coloque arquivos .csv manualmente na pasta `dados/`.")
    else:
        nomes = [os.path.basename(a) for a in arquivos]
        selecionados = st.multiselect("Escolha quais corridas comparar", nomes, default=nomes[-min(3, len(nomes)):])

        if selecionados:
            linhas_metricas = []
            corridas = {}
            for nome in selecionados:
                caminho = os.path.join(DADOS_DIR, nome)
                try:
                    df = carregar_e_limpar(caminho)
                    corridas[nome] = df
                    m = calcular_metricas(df)
                    m["Arquivo"] = nome
                    linhas_metricas.append(m)
                except Exception as e:
                    st.warning(f"Não consegui ler {nome}: {e}")

            if linhas_metricas:
                tabela = pd.DataFrame(linhas_metricas)
                cols_ordem = ["Arquivo", "MAE", "RMSE", "Overshoot", "Oscilações", "Esforço PWM", "Perdas de linha"]
                tabela = tabela[cols_ordem].sort_values("RMSE").reset_index(drop=True)
                st.subheader("Tabela comparativa")
                st.dataframe(tabela, use_container_width=True)
                st.subheader("Comparação de erro ao longo do tempo")
                fig, ax = plt.subplots(figsize=(11, 5))
                for nome, df in corridas.items():
                    ax.plot(df["time_s"], df["erro"], linewidth=1, label=nome)
                ax.axhline(0, color="gray", linestyle="--", linewidth=0.8)
                ax.set_xlabel("Tempo (s)")
                ax.set_ylabel("Erro")
                ax.legend(fontsize=8)
                ax.grid(alpha=0.3)
                st.pyplot(fig)

                st.subheader("Configuração recomendada")
                st.caption("Critério: primeiro elimina quem perdeu mais a linha (segurança), depois escolhe menor RMSE entre as que sobraram (precisão/estabilidade).")

                min_perdas = tabela["Perdas de linha"].min()
                candidatas = tabela[tabela["Perdas de linha"] == min_perdas]
                recomendada = candidatas.sort_values("RMSE").iloc[0]

                col_a, col_b = st.columns([2, 3])
                with col_a:
                    st.success(f"**{recomendada['Arquivo']}**")
                    st.metric("RMSE", recomendada["RMSE"])
                    st.metric("Perdas de linha", int(recomendada["Perdas de linha"]))
                with col_b:
                    n_candidatas = len(candidatas)
                    n_total = len(tabela)
                    st.write(
                        f"Das {n_total} corridas selecionadas, {n_candidatas} tiveram o menor "
                        f"número de perdas de linha ({int(min_perdas)}). Entre essas, esta foi a "
                        f"que teve o menor erro (RMSE)."
                    )
                    st.caption(
                        "isso não mede tempo de prova diretamente -- se quiser priorizar "
                        "velocidade também, compare manualmente na tabela acima."
                    )
         
                # ESTATÍSTICA APROFUNDADA: boxplot + análise por trecho
           
                st.divider()
                st.subheader("Distribuição do erro (boxplot)")
                fig_box, ax_box = plt.subplots(figsize=(11, 5))
                dados_box = [df["erro"] for df in corridas.values()]
                rotulos_box = list(corridas.keys())
                ax_box.boxplot(dados_box, tick_labels=rotulos_box, showmeans=True)
                ax_box.tick_params(axis="x", rotation=30)
                ax_box.set_ylabel("Erro")
                ax_box.axhline(0, color="gray", linestyle="--", linewidth=0.8)
                ax_box.grid(alpha=0.3, axis="y")
                fig_box.tight_layout()
                st.pyplot(fig_box)
                st.caption(
                    "Muitos pontos fora da caixa são esperados: a maior parte do tempo o "
                    "robô está numa reta (erro perto de zero), então os picos das curvas "
                    "aparecem como 'discrepantes' estatisticamente, mesmo sendo normais."
                )
                st.subheader("Desvio padrão do erro por trecho da pista")

                def classificar_trecho(erro):
                    e = abs(erro)
                    if e < 400:
                        return "reta"
                    elif e < 1200:
                        return "curva_media"
                    else:
                        return "curva_fechada"
                linhas_trecho = []
                for nome, df in corridas.items():
                    df_t = df.copy()
                    df_t["trecho"] = df_t["erro"].apply(classificar_trecho)
                    std_por_trecho = df_t.groupby("trecho")["erro"].std()
                    contagem = df_t["trecho"].value_counts()
                    linha = {"Arquivo": nome}
                    for trecho in ["reta", "curva_media", "curva_fechada"]:
                        std_val = std_por_trecho.get(trecho, float("nan"))
                        n_val = int(contagem.get(trecho, 0))
                        linha[f"std_{trecho}"] = round(std_val, 1) if pd.notna(std_val) else None
                        linha[f"n_{trecho}"] = n_val
                    linhas_trecho.append(linha)
                tabela_trecho = pd.DataFrame(linhas_trecho)
                st.dataframe(tabela_trecho, use_container_width=True)
                st.caption(
                    "std_X = desvio padrão do erro nesse trecho (menor = mais estável). "
                    "n_X = quantas amostras caíram nesse trecho -- desconfie de std muito "
                    "baixo se o n também for muito baixo (amostra pequena engana)."
                )
