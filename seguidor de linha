// derivada: quanto uma coisa muda em determinado instante/ taxa de variação
// integral: quanto foi acumulado ao longo do tempo



#include <Arduino.h>
#include <QTRSensors.h>
#include "bluetooth_logger.h" // arq para eu me comunicar com o bluetooth do esp  e fazer a análise de dados



// #define MODO_DEBUG

// ==================== PINOS ====================
#define NUM_SENSORS 8

const uint8_t QTR_PINS[NUM_SENSORS] = {32, 33, 34, 35, 36, 39, 25, 26};
#define PIN_LEDON 13

#define PIN_AIN1 19
#define PIN_AIN2 21
#define PIN_PWMA 18
#define PIN_BIN1 22
#define PIN_BIN2 27
#define PIN_PWMB 23
#define PIN_STBY 14

// PINOS DO LED DE STATUS (livres -- não conflitam com sensores/motores)
#define PIN_LED_VERMELHO 4
#define PIN_LED_VERDE    5
#define PIN_LED_AZUL     16

// ==================== PWM ====================
const int PWM_FREQ    = 5000;
const int PWM_RES     = 8;
const int CH_ESQUERDO = 0;
const int CH_DIREITO  = 1;

// ==================== VELOCIDADES ====================
const int PWM_MAX         = 255;
const int VELOCIDADE_BASE = 200;
const int VEL_MIN_CURVA   = -100;

int leftTrim  = 0;
int rightTrim = 0;

// ==================== PID ====================
float Kp = 0.06f;
float Ki = 0.0000f;
float Kd = 0.4f;

float ultimoErro = 0.0f;
float integral   = 0.0f;
float erroDerivativoFiltrado = 0.0f;

const float INTEGRAL_MAX  = 50.0f;
const int   POSICAO_ALVO  = 3500;
const int   LINHA_PERDIDA_LIMIAR = 250;

// ==================== LIMIARES DE ERRO ====================
const int ERRO_PEQUENO = 400;
const int ERRO_MEDIO   = 1200;
const int ERRO_GRANDE  = 2500;

// ==================== RECUPERAÇÃO DE LINHA ====================
float         ultimaDirecao     = 0.0f;
bool          linhaPerdida      = false;
unsigned long tempoSemLinha     = 0;
const unsigned long MAX_TEMPO_RECUPERACAO = 400;

// ==================== LINHA DE CHEGADA / VOLTAS ====================
bool          corridaIniciada      = false;
unsigned long tempoInicioVolta     = 0; // guarda quando a volta começou
int           numeroVolta          = 0; // quantas voltaas por sessão
int           contadorLinhaChegada = 0;  // qnts vezes passou pela linha de partida
const int     CICLOS_CONFIRMACAO   = 5; // qnts leituras seguidas de tudo preto, para poder confirmar
const int     LIMITE_LINHA_CHEGADA = 500;  // valor acima do qual um sensor é considerado "vendo preto"
unsigned long tempoVolta = 0
// ========== OBJETOS DE UMA CLASSE ====================
QTRSensors qtr;
uint16_t   valoresSensores[NUM_SENSORS];

// FUNCOES
void controlarMotores(int esquerdo, int direito);
void pararMotores();
bool linhaDetectada();
void recuperarLinha();
void calibrar();
void handleSerialCommands();









// ==================== CALIBRAÇÃO ====================
void calibrar() {
  Serial.println(">>> Assim que o LED vermelho acender, mova o robô lateralmente sobre a linha!");

  pinMode(LED_BUILTIN, OUTPUT);
  for(int i=0; i<6; i++){
    digitalWrite(LED_BUILTIN, !digitalRead(LED_BUILTIN));
    delay(200);
  }

  Serial.println(">>> COMEÇANDO A CALIBRAR");
  
  digitalWrite(PIN_LED_VERMELHO, HIGH); // acende o LED vermelho
  digitalWrite(PIN_LED_VERDE, LOW);  // apaga o LED verde
  digitalWrite(PIN_LED_AZUL, LOW);  // apaga o azul

  for (uint16_t i = 0; i < 250; i++) {
    qtr.calibrate();
    delay(8);
  }

  digitalWrite(LED_BUILTIN, LOW);
  Serial.println(">>> Calibração concluída !! ");
}






// ==================== SETUP ====================
void setup() {
  Serial.begin(115200);
  delay(100);

  // DEFININDO PINO DO LED PARA OBTER STATUS
  pinMode(PIN_LED_VERMELHO, OUTPUT); // pino do LED vermelho
  pinMode(PIN_LED_VERDE, OUTPUT); // pino do LED verde
  pinMode(PIN_LED_AZUL, OUTPUT); // pino do LED azul

  digitalWrite(PIN_LED_VERMELHO, LOW); // apaga o LED vermelho
  digitalWrite(PIN_LED_VERDE, LOW);  // apaga o LED verde
  digitalWrite(PIN_LED_AZUL, HIGH);  // acende led azul

  btLogBegin();
  // ela aq vai inicializar a função do arq bluetooth para ligar essa funcao no esp

  

  // para todos esses vou mandar um sinal 
  pinMode(PIN_AIN1, OUTPUT);
  pinMode(PIN_AIN2, OUTPUT);
  pinMode(PIN_BIN1, OUTPUT);
  pinMode(PIN_BIN2, OUTPUT);
  pinMode(PIN_STBY, OUTPUT);

  pararMotores();

  // stand by é quando n tem controle ativo de nada especificamente e o consumo reduzido
  digitalWrite(PIN_STBY, LOW);
  // pega e bota o pino em nível alto
  
  


  // aq configuro:
  // frequencia: quantos ciclos por segundo do pwm
  // resolução(n): sendo n o número de bits, 2^n é oo número de possibilidades/ níveis de pwm
  //               nesse caso, a resoluação é de 8 bites, tendo-se 256 combinações, porém já que se parte do 0
  //               o pwm pode ir de 0 até 255

  ledcSetup(CH_ESQUERDO, PWM_FREQ, PWM_RES);
  ledcSetup(CH_DIREITO,  PWM_FREQ, PWM_RES);


  //            pino      canal q vai sair
  ledcAttachPin(PIN_PWMA, CH_ESQUERDO); 
  ledcAttachPin(PIN_PWMB, CH_DIREITO); 


  // diz pro canal X, gere PWM usando este valor, se for tipo 128 ele so estaria usando metade do seu máximo
  ledcWrite(CH_ESQUERDO, 0);  
  ledcWrite(CH_DIREITO,  0); 


  qtr.setTypeAnalog(); // para dizer q são analógicos
  qtr.setSensorPins(QTR_PINS, NUM_SENSORS); // set
  qtr.setEmitterPin(PIN_LEDON); // configurando o pino


  calibrar(); // feita no stby
  
  ultimoErro = 0.0f;
  integral   = 0.0f;
  erroDerivativoFiltrado = 0.0f;

  digitalWrite(PIN_STBY, HIGH);
 

  digitalWrite(PIN_LED_VERMELHO, LOW); // apaga o LED vermelho
  digitalWrite(PIN_LED_VERDE, HIGH);  // acende o LED verde
  digitalWrite(PIN_LED_AZUL, LOW);  // apaga o LED azul
  Serial.println("\n>>>>>> Pronto >>>>>>>>");
  
  delay(500);
}










1ª cruzada  → só marca a LARGADA (começa a cronometrar a volta 1)
2ª cruzada  → fecha a volta 1 (calcula o tempo) E já abre a volta 2 no mesmo instante
3ª cruzada  → fecha a volta 2 E já abre a volta 3
4ª cruzada  → fecha a volta 3 E já abre a volta 4
...e assim por diante, quantas voltas o robô der



// ==================== LOOP ====================
void loop() {
  uint16_t posicao = qtr.readLineBlack(valoresSensores);
  

  if (todosOsSensoresPretos()) {
    contadorLinhaChegada++;
  } else {
    contadorLinhaChegada = 0;
  }


// vito quee contador de linha de chegada é apenas quantos ciclos com todos lendo preto
  if (contadorLinhaChegada == CICLOS_CONFIRMACAO) {
    if (!corridaIniciada) {
      corridaIniciada = true;
      numeroVolta = 1;
      tempoInicioVolta = millis();
    } else {
      tempoVolta = millis() - tempoInicioVolta;
      numeroVolta++;
      numeroVolta++;
      tempoInicioVolta = millis();
    }
  }
  // if detectar todos pretos por 5 leituras, começa a contar o cronômetro

  while numeroVolta > 1

  if (!linhaDetectada()) {
    if (!linhaPerdida) {
      linhaPerdida  = true;
      tempoSemLinha = millis();
    }
    recuperarLinha();
    return;
  }


  linhaPerdida = false;

  float erro = (float)posicao - POSICAO_ALVO;

  float P = erro;

  integral += erro;
  integral  = constrain(integral, -INTEGRAL_MAX, INTEGRAL_MAX);
  float I   = integral;

  float D_atual = erro - ultimoErro;
  erroDerivativoFiltrado = (0.6f * erroDerivativoFiltrado) + (0.4f * D_atual);
  ultimoErro = erro;

  float sinalControle = (Kp * P) + (Ki * I) + (Kd * erroDerivativoFiltrado);
  ultimaDirecao = sinalControle;

  int velBase;
  float absErro = abs(erro);

  if (absErro < ERRO_PEQUENO) {
    velBase = VELOCIDADE_BASE + 30;
  } else if (absErro < ERRO_MEDIO) {
    velBase = VELOCIDADE_BASE;
  } else if (absErro < ERRO_GRANDE) {
    velBase = (int)(VELOCIDADE_BASE * 0.70f);
  } else {
    velBase = (int)(VELOCIDADE_BASE * 0.45f);
  }

  int velEsq = velBase + (int)sinalControle + leftTrim;
  int velDir = velBase - (int)sinalControle + rightTrim;

  velEsq = constrain(velEsq, VEL_MIN_CURVA, PWM_MAX);
  velDir = constrain(velDir, VEL_MIN_CURVA, PWM_MAX);





  if (todosOsSensoresPretos()) {
    contadorLinhaChegada++;
  } else {
    contadorLinhaChegada = 0;  // qualquer leitura "normal" no meio zera a contagem
  }

  if (contadorLinhaChegada == CICLOS_CONFIRMACAO) {
  // cruzou a linha de chegada de verdade -- aqui entra a lógica de início/fim
  }




  controlarMotores(velEsq, velDir);

  btLogData(erro, Kp, Ki, Kd, integral, erroDerivativoFiltrado,
  valoresSensores, posicao, velEsq, velDir, velBase, numeroVolta);

#ifdef MODO_DEBUG
  static unsigned long ultimoDebug = 0;
  if (millis() - ultimoDebug > 100) {
    ultimoDebug = millis();
    Serial.print("Pos:"); Serial.print(posicao);
    Serial.print(" Err:"); Serial.print((int)erro);
    Serial.print(" SC:"); Serial.print(sinalControle, 1);
    Serial.print(" L:"); Serial.print(velEsq);
    Serial.print(" R:"); Serial.println(velDir);
  }
  handleSerialCommands();
#endif
}













// ==================== DETECÇÃO DE LINHA ====================
bool linhaDetectada() {
  for (uint8_t i = 0; i < NUM_SENSORS; i++) {
    if (valoresSensores[i] > LINHA_PERDIDA_LIMIAR) return true;
  }
  return false;
}

bool todosOsSensoresPretos() {
  for (uint8_t i = 0; i < NUM_SENSORS; i++) {
    if (valoresSensores[i] < LIMITE_LINHA_CHEGADA) return false;
    // achou um sensor "não preto" -> não é a linha de chegada
  }
  }
  return true;
}

// ==================== RECUPERAÇÃO DE LINHA ====================
void recuperarLinha() {
  if (millis() - tempoSemLinha > MAX_TEMPO_RECUPERACAO) {
    pararMotores();
    return;
  }

  int velGiro = 140;
  if (ultimaDirecao > 0) {
    controlarMotores(velGiro, -velGiro);
  } else {
    controlarMotores(-velGiro, velGiro);
  }
}

// ==================== CONTROLE DOS MOTORES ====================
void controlarMotores(int esquerdo, int direito) {
  if (esquerdo >= 0) {
    digitalWrite(PIN_AIN1, LOW);
    digitalWrite(PIN_AIN2, HIGH);
    ledcWrite(CH_ESQUERDO, (uint32_t)esquerdo);
  } else {
    digitalWrite(PIN_AIN1, HIGH);
    digitalWrite(PIN_AIN2, LOW);
    ledcWrite(CH_ESQUERDO, (uint32_t)abs(esquerdo));
  }

  if (direito >= 0) {
    digitalWrite(PIN_BIN1, HIGH);
    digitalWrite(PIN_BIN2, LOW);
    ledcWrite(CH_DIREITO, (uint32_t)direito);
  } else {
    digitalWrite(PIN_BIN1, LOW);
    digitalWrite(PIN_BIN2, HIGH);
    ledcWrite(CH_DIREITO, (uint32_t)abs(direito));
  }
}

void pararMotores() {
  digitalWrite(PIN_AIN1, LOW);
  digitalWrite(PIN_AIN2, LOW);
  digitalWrite(PIN_BIN1, LOW);
  digitalWrite(PIN_BIN2, LOW);
  ledcWrite(CH_ESQUERDO, 0);
  ledcWrite(CH_DIREITO,  0);  // põe no nível 0
}






